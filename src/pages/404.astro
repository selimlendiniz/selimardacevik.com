---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { routes, ui } from '~/i18n/ui';

// A static build renders this page once and Vercel serves it for unknown paths
// in both language trees, so the language cannot be read off the URL. Show
// both languages instead of guessing, and mark each block with its own lang.
const blocks = [
  { lang: 'en' as const, home: routes.en.home, blog: routes.en.blog },
  { lang: 'tr' as const, home: routes.tr.home, blog: routes.tr.blog },
];
---

<BaseLayout
  title={ui.en['404.title']}
  description={ui.en['404.description']}
  lang="en"
  noindex
>
  <p class="text-sm font-medium tracking-widest text-ink-muted dark:text-ink-muted-dark">404</p>

  <div class="mt-4 space-y-10">
    {
      blocks.map(({ lang, home, blog }) => (
        <section lang={lang}>
          <h2 class="text-2xl font-bold tracking-tight">{ui[lang]['404.title']}</h2>
          <p class="mt-2 text-ink-muted dark:text-ink-muted-dark">{ui[lang]['404.description']}</p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a class="text-accent hover:underline dark:text-accent-dark" href={home}>
              {ui[lang]['404.home']}
            </a>
            <a class="text-accent hover:underline dark:text-accent-dark" href={blog}>
              {ui[lang]['blog.title']}
            </a>
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>
