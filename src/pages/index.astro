---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Home from '~/components/pages/Home.astro';
import { SITE } from '~/config';
import { routes } from '~/i18n/ui';
import { personSchema, websiteSchema } from '~/lib/schema';

const lang = 'en' as const;
const site = Astro.site ?? SITE.url;
---

<BaseLayout
  title={SITE.name}
  description={SITE.intro[lang]}
  lang={lang}
  alternates={{ en: routes.en.home, tr: routes.tr.home }}
  jsonLd={[personSchema(lang, site), websiteSchema(lang, site)]}
>
  <Home lang={lang} />
</BaseLayout>
