---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogIndex from '~/components/pages/BlogIndex.astro';
import { routes } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { getPosts, type Post } from '~/lib/content';

const lang = 'tr' as const;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPosts('tr');
  return paginate(posts, { pageSize: 10 });
};

const { page } = Astro.props as {
  page: {
    data: Post[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
};
const t = useTranslations(lang);
const isFirstPage = page.currentPage === 1;
---

<BaseLayout
  title={isFirstPage ? t('blog.title') : `${t('blog.title')} — ${t('blog.page')} ${page.currentPage}`}
  description={t('blog.description')}
  lang={lang}
  alternates={{ en: routes.en.blog, tr: routes.tr.blog }}
  noindex={!isFirstPage}
>
  <BlogIndex
    lang={lang}
    posts={page.data}
    current={page.currentPage}
    total={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</BaseLayout>
