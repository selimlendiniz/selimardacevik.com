---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogPost from '~/components/pages/BlogPost.astro';
import { routes } from '~/i18n/ui';
import { postPath } from '~/i18n/utils';
import { getPosts, translationsOf, type Post } from '~/lib/content';
import { blogPostingSchema } from '~/lib/schema';
import { SITE } from '~/config';

const lang = 'en' as const;

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts('en');
  // posts is newest first, so the previous index is the newer neighbour.
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
};

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const languages = await translationsOf(post.slug);
const site = Astro.site ?? SITE.url;
const alternates = {
  en: languages.includes('en') ? postPath('en', post.slug) : routes.en.blog,
  tr: languages.includes('tr') ? postPath('tr', post.slug) : routes.tr.blog,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  alternates={alternates}
  image={post.data.ogImage ?? post.data.cover?.src}
  type="article"
  publishedTime={post.data.pubDate}
  jsonLd={blogPostingSchema(post, lang, Astro.url, site, post.data.ogImage ?? '/og-default.png')}
>
  <BlogPost post={post} lang={lang} newer={newer} older={older} />
</BaseLayout>
