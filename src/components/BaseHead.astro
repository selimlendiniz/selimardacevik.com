---
import { SITE } from '~/config';
import { languages, routes, type Lang } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Absolute paths for this page in each language it exists in. */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description,
  lang,
  alternates = { en: routes.en.home, tr: routes.tr.home },
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
// Drop og:image entirely when there is no share image, rather than linking a 404.
const ogImage = image ? new URL(image, Astro.site ?? SITE.url) : undefined;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<link rel="canonical" href={canonical} />

{
  Object.entries(alternates).map(([code, path]) => (
    <link rel="alternate" hreflang={code} href={new URL(path, Astro.site ?? SITE.url)} />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(alternates.en ?? routes.en.home, Astro.site ?? SITE.url)} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — ${languages[lang]}`}
  href={new URL(routes[lang].rss, Astro.site ?? SITE.url)}
/>

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
<meta property="og:site_name" content={SITE.name} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const dark = stored
        ? stored === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch {
      /* storage blocked: fall back to the light theme */
    }
  })();
</script>
