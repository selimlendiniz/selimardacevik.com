---
import { useTranslations, type Lang } from '~/i18n/utils';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);

// h1 is the post title and h4+ is too fine-grained to navigate by.
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 1 && (
    <nav
      aria-label={t('blog.toc')}
      class="mt-8 rounded-lg border border-line p-4 dark:border-line-dark"
      data-print-hide
    >
      <h2 class="text-sm font-semibold tracking-tight">{t('blog.toc')}</h2>
      <ol class="mt-2 space-y-1 text-sm">
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && 'ps-4']}>
            <a
              href={`#${heading.slug}`}
              class="text-ink-muted transition hover:text-accent dark:text-ink-muted-dark dark:hover:text-accent-dark"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
