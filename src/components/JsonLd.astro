---
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
const payload = Array.isArray(schema) ? schema : [schema];
---

{
  payload.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />
  ))
}
