---
import { SITE } from '~/config';
import { route, useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { label: 'GitHub', href: SITE.social.github, handle: 'selimlendiniz' },
  { label: 'LinkedIn', href: SITE.social.linkedin, handle: 'selimardacevik' },
] as const;
---

<h1 class="text-3xl font-bold tracking-tight">{t('contact.title')}</h1>
<p class="mt-3 max-w-prose leading-relaxed text-ink-muted dark:text-ink-muted-dark">
  {t('contact.description')}
</p>

<a
  href={`mailto:${SITE.email}`}
  class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 font-medium text-white transition hover:bg-accent-strong"
>
  {SITE.email}
</a>

<section class="mt-12">
  <h2 class="text-xl font-semibold tracking-tight">{t('contact.openTo')}</h2>
  <ul class="mt-4 space-y-3 text-ink-muted dark:text-ink-muted-dark">
    <li class="border-s-2 border-line ps-4 dark:border-line-dark">{t('contact.openTo.roles')}</li>
    <li class="border-s-2 border-line ps-4 dark:border-line-dark">
      {t('contact.openTo.questions')}
    </li>
    <li class="border-s-2 border-line ps-4 dark:border-line-dark">{t('contact.openTo.work')}</li>
  </ul>
  <p class="mt-4 text-sm text-ink-muted dark:text-ink-muted-dark">
    <a class="text-accent hover:underline dark:text-accent-dark" href={route(lang, 'cv')}>
      {t('contact.cvHint')}
    </a>
  </p>
</section>

<section class="mt-12">
  <h2 class="text-xl font-semibold tracking-tight">{t('contact.elsewhere')}</h2>
  <ul class="mt-4 divide-y divide-line dark:divide-line-dark">
    {
      links.map((link) => (
        <li class="flex items-baseline gap-4 py-3">
          <a
            class="font-medium hover:text-accent dark:hover:text-accent-dark"
            href={link.href}
            rel="me noopener"
          >
            {link.label}
          </a>
          <span class="ms-auto text-sm text-ink-muted dark:text-ink-muted-dark">
            {link.handle}
          </span>
        </li>
      ))
    }
  </ul>
</section>
