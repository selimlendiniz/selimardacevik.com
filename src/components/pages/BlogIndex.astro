---
import PostCard from '~/components/PostCard.astro';
import Pagination from '~/components/Pagination.astro';
import { route, tagPath, useTranslations, type Lang } from '~/i18n/utils';
import { getTags, type Post } from '~/lib/content';

interface Props {
  lang: Lang;
  posts: Post[];
  current: number;
  total: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { lang, posts, current, total, prevUrl, nextUrl } = Astro.props;
const t = useTranslations(lang);
const tags = (await getTags(lang)).slice(0, 8);
---

<div class="flex flex-wrap items-baseline gap-4">
  <h1 class="text-3xl font-bold tracking-tight">{t('blog.title')}</h1>
  <a
    href={route(lang, 'search')}
    class="ms-auto text-sm text-accent hover:underline dark:text-accent-dark"
  >
    {t('search.title')}
  </a>
</div>
<p class="mt-2 text-ink-muted dark:text-ink-muted-dark">{t('blog.description')}</p>

{
  tags.length > 0 && (
    <ul class="mt-6 flex flex-wrap items-center gap-2 text-sm">
      {tags.map(({ tag, count }) => (
        <li>
          <a
            href={tagPath(lang, tag)}
            class="rounded bg-paper-raised px-2 py-1 text-ink-muted transition hover:text-accent dark:bg-paper-raised-dark dark:text-ink-muted-dark dark:hover:text-accent-dark"
          >
            {tag} <span class="opacity-60">{count}</span>
          </a>
        </li>
      ))}
      <li>
        <a
          href={route(lang, 'tags')}
          class="text-accent hover:underline dark:text-accent-dark"
        >
          {t('blog.allTags')}
        </a>
      </li>
    </ul>
  )
}

<div class="mt-8">
  {
    posts.length === 0 ? (
      <p class="text-ink-muted dark:text-ink-muted-dark">{t('blog.empty')}</p>
    ) : (
      posts.map((post) => <PostCard post={post} lang={lang} />)
    )
  }
</div>

<Pagination lang={lang} current={current} total={total} prevUrl={prevUrl} nextUrl={nextUrl} />
